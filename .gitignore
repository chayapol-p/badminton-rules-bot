# Secrets: API keys live only here, never in code
.env

# Corpus: BWF rule-book PDFs and the chunks made from them, never committed
data/

# Python environment and caches
.venv/
__pycache__/
.pytest_cache/

# macOS
.DS_Store

# Dry runs check the API settings only: never a result
evals/answer_runs/*-dry-run-*

# A re-judge in progress, or one an API error stopped: never a result
evals/answer_runs/*.partial.jsonl
