# Copy this file to .env and paste your keys after the = signs.
# .env is in .gitignore, so your keys never reach git.

# Database for vector search: Supabase > Connect > Session pooler (works over IPv4).
# Replace [YOUR-PASSWORD] with your database password.
DATABASE_URL=

# Which bot answers /chat: stub (the default: a fixed answer, no API calls) or real (calls Mistral, about $0.04 a question)
# RULES_BOT=real

# API keys. Mistral is required.
MISTRAL_API_KEY=
# Optional: needed only for the answer judge and the experiment runs
ANTHROPIC_API_KEY=

# Model names (optional: the defaults live in app/settings.py)
# MISTRAL_ANSWER_MODEL=mistral-large-4-0
# MISTRAL_DRAFT_MODEL=mistral-small-2603
# MISTRAL_EMBEDDING_MODEL=mistral-embed-2312
# MISTRAL_REASONING_EFFORT=low
# CLAUDE_COMPARISON_MODEL=claude-haiku-5-5
# CLAUDE_JUDGE_MODEL=claude-sonnet-5-5
